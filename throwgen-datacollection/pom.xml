<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>
  <groupId>org.throwgen.core</groupId>
  <artifactId>throwgen-datacollection</artifactId>
  <version>1.0-SNAPSHOT</version>
  <name>throwgen-datacollection</name>
  <properties>
    <project.build.sourceEncoding>
    UTF-8</project.build.sourceEncoding>
    <!-- Java 8, to match the JDK the subject projects are built with.  Nothing
         here uses post-8 syntax, and the Python side puts a single `java` on
         PATH for both this and the projects under test, so they have to agree. -->
    <maven.compiler.source>8</maven.compiler.source>
    <maven.compiler.target>8</maven.compiler.target>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.googlecode.json-simple</groupId>
      <artifactId>json-simple</artifactId>
      <version>1.1.1</version>
    </dependency>
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm</artifactId>
      <version>9.7</version>
    </dependency>
    <dependency>
      <groupId>com.github.javaparser</groupId>
      <artifactId>javaparser-symbol-solver-core</artifactId>
      <version>3.26.3</version>
    </dependency>
  </dependencies>
  <build>
    <pluginManagement>
      <!-- lock down plugins versions to avoid using Maven defaults (may be moved to parent pom) -->
      <plugins>
        <!-- clean lifecycle, see https://maven.apache.org/ref/current/maven-core/lifecycles.html#clean_Lifecycle -->
        <plugin>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.4.0</version>
        </plugin>
        <!-- default lifecycle, jar packaging: see https://maven.apache.org/ref/current/maven-core/default-bindings.html#Plugin_bindings_for_jar_packaging -->
        <plugin>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.3.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.1.2</version>
        </plugin>
        <plugin>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.1.2</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.5.0</version>
          <executions>
            <execution>
              <id>exception-collect</id>
              <configuration>
                <mainClass>
                org.throwgen.core.ExceptionSignatureCollector</mainClass>
              </configuration>
            </execution>
            <execution>
              <id>throw-remove</id>
              <configuration>
                <mainClass>
                org.throwgen.core.ThrowRemover</mainClass>
              </configuration>
            </execution>
            <execution>
              <id>parent-finder</id>
              <configuration>
                <mainClass>
                org.throwgen.core.ParentFinder</mainClass>
              </configuration>
            </execution>
            <execution>
              <id>class-data-gen</id>
              <configuration>
                <mainClass>
                org.throwgen.core.ClassDataCollector</mainClass>
              </configuration>
            </execution>
            <execution>
              <id>constructor-data</id>
              <configuration>
                <mainClass>
                org.throwgen.core.ConstructorCollector</mainClass>
              </configuration>
            </execution>
            <execution>
              <id>local-variable</id>
              <configuration>
                <mainClass>
                org.throwgen.core.LocalVariableTypeCollector</mainClass>
              </configuration>
            </execution>
            <execution>
              <id>try-catch-add</id>
              <configuration>
                <mainClass>
                org.throwgen.core.TryCatchAdder</mainClass>
              </configuration>
            </execution>
            <execution>
              <id>calls</id>
              <configuration>
                <mainClass>
                org.throwgen.core.CallsCollector</mainClass>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-assembly-plugin</artifactId>
          <configuration>
          <descriptorRefs>
            <descriptorRef>jar-with-dependencies</descriptorRef>
          </descriptorRefs>s
          <archive>
            <manifestEntries>
              <Premain-Class>
              org.throwgen.core.CoverageCollector</Premain-Class>
              <Can-Redefine-Classes>true</Can-Redefine-Classes>
            </manifestEntries>
          </archive>
          <appendAssemblyId>true</appendAssemblyId></configuration>
          <executions>
            <execution>
              <id>coverage-agent-assembly</id>
              <phase>package</phase>
              <goals>
                <goal>single</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
